# App configuration. These two are all the app needs: it talks straight to
# Supabase, and Row Level Security on the weak_* tables scopes every query to
# the signed-in user.
#
# EXPO_PUBLIC_* values are compiled into the client bundle, so treat them as
# public. Always the ANON key here -- never the service key.
#
# Expo reads mobile/.env for both `expo start` and the web build; put these
# there too (or set them in the environment) when working locally.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────
# Legacy: backend/ only.
# ─────────────────────────────────────────────────────────────
# The app no longer calls the Express server -- these are needed only if you
# still run backend/ for local scripting. The service key bypasses RLS, so it
# must never reach a client bundle or a browser.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
