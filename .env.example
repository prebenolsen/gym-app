# Mobile + Web app configuration (EXPO_PUBLIC_* is bundled into the client).
# These are the same variables used by the web PWA build (npm run build:web).
# Keep using the Supabase ANON key here (never the service key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# For local mobile/web dev this points at the local backend.
# For the deployed web PWA this MUST be your publicly reachable backend URL
# (e.g. https://api.yourdomain.com) and that backend must allow CORS from the
# Cloudflare Pages origin. Set it in the Cloudflare Pages dashboard, not here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Backend configuration
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
