# Environment files (never commit secrets)
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
backend/.env
mobile/.env
web/.env
# Catch-all so a suffixed copy (.env.bak, .env.backup, .env.20260817) can never
# slip past the rules above and be committed with real keys in it.
.env.*
**/.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

