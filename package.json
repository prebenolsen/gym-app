{
  "name": "gym-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "shared",
    "backend"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web:mobile": "expo start --web",
    "web:dev": "npm run dev --workspace=web",
    "backend:dev": "npm run dev --workspace=backend"
  },
  "dependencies": {
    "@types/react": "~19.2.10",
    "expo": "^55.0.9",
    "react-dom": "19.2.0",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2"
  }
}