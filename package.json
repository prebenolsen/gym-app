{
  "name": "gym-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "shared",
    "backend"
  ],
  "scripts": {
    "start": "npm run dev --workspace=mobile",
    "android": "npm run android --workspace=mobile",
    "ios": "npm run ios --workspace=mobile",
    "web:mobile": "npm run web --workspace=mobile",
    "mobile:dev": "npm run dev --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:ios": "npm run ios --workspace=mobile",
    "mobile:web": "npm run web --workspace=mobile",
    "web:dev": "npm run dev --workspace=web",
    "backend:dev": "npm run dev --workspace=backend",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3"
  }
}
