{
  "name": "gym-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile",
    "shared",
    "backend"
  ],
  "scripts": {
    "start": "npm run dev --workspace=mobile",
    "android": "npm run android --workspace=mobile",
    "ios": "npm run ios --workspace=mobile",
    "mobile:dev": "npm run dev --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:ios": "npm run ios --workspace=mobile",
    "build:web": "npm run build --workspace=shared && npm run build:web --workspace=mobile",
    "backend:dev": "npm run dev --workspace=backend",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3"
  }
}
